<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Ghost Apps" }}</title>
  {% set pageDescription = description or "Small, independent software — built with care, shipped without ceremony." %}
  <meta name="description" content="{{ pageDescription }}">
  <meta property="og:site_name" content="Ghost Apps">
  <meta property="og:title" content="{{ title or 'Ghost Apps' }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if featured_image else 'website' }}">
  {% if featured_image %}
  <meta property="og:image" content="{{ siteUrl }}{{ featured_image }}">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👻</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body class="min-h-screen flex flex-col bg-gray-950 text-gray-100 font-mono">
  <header class="border-b border-gray-800">
    <nav class="max-w-2xl mx-auto flex items-center gap-6 px-4 py-4">
      <a href="{{ '/' | url }}" class="font-semibold">Ghost Apps</a>
      <a href="{{ '/blog/' | url }}" class="text-gray-400 hover:text-accent">Blog</a>
      <a href="{{ '/links/' | url }}" class="text-gray-400 hover:text-accent">Links</a>
    </nav>
  </header>

  <main class="max-w-2xl mx-auto px-4 py-8 flex-1 w-full">
    <div class="prose prose-invert max-w-none prose-a:text-accent prose-a:no-underline hover:prose-a:underline">
      {{ content | safe }}
    </div>
    {% if page.inputPath | isSigned %}
    {% set src = page.inputPath | sourceUrl %}
    <p class="mt-8 text-sm text-gray-400">
      Signed with our <a href="/pgp.asc" class="text-accent hover:underline">PGP key</a>:
      <a href="{{ src }}" class="text-accent hover:underline">source</a> &middot;
      <a href="{{ src }}.asc" class="text-accent hover:underline">signature</a>
    </p>
    {% endif %}
  </main>

  <footer class="border-t border-gray-800">
    <div class="max-w-2xl mx-auto px-4 py-4 text-sm text-gray-500">
      &copy; {{ currentYear }} Ghost Apps LLC
    </div>
  </footer>
</body>
</html>
